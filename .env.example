# ===== 模型（推荐只设这一个）=====
# 指向 models/current 软链，切版本只改软链、不改这里
MODEL_DIR=models/current

# 单个头的显式覆盖（优先级高于 MODEL_DIR，用于临时实验；生产不要设）
# VISION_WEIGHTS=
# VISION_DET_WEIGHTS=
# VISION_ACTION_WEIGHTS=
# VISION_GROUP_WEIGHTS=
# VISION_BIN_AXLE=
# VISION_BIN_TIRE=
# VISION_BIN_FILTER=

# ===== 推理设备 =====
VISION_DEVICE=mps
# 平台训练的默认设备：auto / cpu / cuda / cuda:0 / mps
TRAIN_DEVICE=auto
VISION_IMGSZ=512
VISION_ACTION_IMGSZ=512
ENABLE_FUSION=0

# ===== 下游服务 =====
VISION_URL=http://127.0.0.1:8016
OCR_SERVICE_URL=http://127.0.0.1:8018
OCR_PROVIDER=rapidocr
OCR_PLATE_SERVER=1

# ===== 可选：外部服务（默认关闭，不可达时不要在健康检查里等）=====
KEV_MODE=off
# KEV_URL=http://10.51.13.7:8008/v1/systemone
USE_VLX=0
# VLX_URL=http://10.51.13.7:8013
# 末页签字/盖章兜底（需要 VLX_URL 可达）；置 0 关闭
VLX_SIGN_FALLBACK=1

# ===== 判定阈值 =====
STRONG_SCENE_CONF=0.85
WEAK_SCENE_CONF=0.75
MIN_SCENE_CONF=0.50
PREPROCESS=auto

# ===== 入口端口 =====
# 服务器上 8080/18080 常被别的服务占用，入口用 8020
HOST_PORT=8020
API_PORT=8017
VISION_PORT=8016
OCR_PORT=8018
# vision 使用哪张 GPU（nvidia-smi 里的编号）
GPU_ID=4

# ===== 并发与准入 =====
MAX_CONCURRENT=48
RATE_LIMIT_PER_MIN=3000
ADMISSION_WAIT_S=1

# ===== 分析行为 =====
# 对外承诺单张 P95 < 5s；这个值同时是接口硬截止
REQUEST_DEADLINE_S=5
# 单张 OCR 总预算（角度重试共享）。超过就返回识别失败，不拖满 5s
OCR_BUDGET_S=2.5
# 车牌 server rec 二次重试预算
OCR_PLATE_RETRY_S=1.0

# ---- 统一 SSO（DEEPWAY）----
# off  = 不校验（默认）
# mock = 本地联调，任意 Token 通过，返回固定用户与全部权限
# live = 生产，向用户中心校验
SSO_MODE=off
SSO_OPEN_LOGIN_DOMAIN=
SSO_APP_CODE=
SSO_POOL_CODE=
SSO_USER_BASE=

# 对外暴露时才需要；内网留空
API_KEYS=

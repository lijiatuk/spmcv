# ---- 统一 SSO（DEEPWAY）----
# 值来自 SSO 管理员 + 从 ihome 登录包探测到的网关地址
SSO_MODE=off
SSO_OPEN_LOGIN_DOMAIN=//ihome-dev01.deepway-inc.com
SSO_APP_CODE=2ee570a2974242bbaf3d9c9e64b20954
SSO_POOL_CODE=123456iop
SSO_USER_BASE=//iov-gw-dev01.api.deepway-inc.com

# v5.1.0 只换了 scene 头；group/action 仍是旧数据训的，融合会拖低精度
ENABLE_FUSION=0

# ---- 部署（compose 读取）----
# 对外入口：控制台 + 统一接口
HOST_PORT=8020
# 三个服务的直连端口
API_PORT=8017
VISION_PORT=8016
OCR_PORT=8018
# vision 使用哪张 GPU（nvidia-smi 里的编号）
GPU_ID=4

# ---- 接口准入 ----
MAX_CONCURRENT=8
RATE_LIMIT_PER_MIN=120
ADMISSION_WAIT_S=2

# ---- 分析行为 ----
SEQUENTIAL_PHOTOS=6
REQUEST_DEADLINE_S=5
OCR_BUDGET_S=6.0
